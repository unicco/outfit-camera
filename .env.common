# ============================================================================
# .env.common - 共通環境変数 (すべてのセッションで同じ値)
# Git 管理可能 (.github で管理OK) - シークレット情報は含まない
# ============================================================================


# === Application Configuration ===
DB_ECHO=false
LOG_LEVEL=INFO
CAMERA_MODE=simulation
EDGE_FILTER_ENABLED=false

# === PIR Sensor Configuration ===
PIR_ENABLED=true
PIR_GPIO_PIN=18
PIR_DETECTION_THRESHOLD=1
PIR_DETECTION_WINDOW=3
CAMERA_ACTIVE_DURATION=300
PIR_SIMULATION_MODE=false


# === Camera Resolution Configuration ===
# 16:9 aspect ratio for consistent live stream and capture
CAMERA_DETECTION_WIDTH=960
CAMERA_DETECTION_HEIGHT=540
CAMERA_CAPTURE_WIDTH=1280
CAMERA_CAPTURE_HEIGHT=720

# === AI/ML Configuration ===
# Gemini モデルID（デフォルト: gemini-2.5-flash-image-preview）
# GEMINI_MODEL_ID=gemini-2.5-flash-image-preview

# === Wardrobe Management ===
ENABLE_HYBRID_MATCHING=true

# === Performance Settings ===
MAX_WORKERS=4
BATCH_SIZE=1

# === Memory Optimization Settings (Raspberry Pi) ===
PYTHONOPTIMIZE=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=0
MALLOC_TRIM_THRESHOLD_=100000

# === Shared Virtual Environment Configuration ===
# Manager リポジトリの共有 venv を使用（worktree でのインストール時間を削減）
# 環境固有のパスは .env ファイルで設定してください
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
UVICORN_WORKERS=1

# === Path Templates (相対パス) ===
PHOTOS_DIR=photos
DAILY_TRACKER_DATA_DIR=data

# === Shared Virtual Environment Configuration ===
# Manager リポジトリの共有 venv を使用（worktree でのインストール時間を削減）
# 注意: coordinate-recorder/.venvs ではなく coordinate-recorder-manager/.venvs を使用
PIP_CACHE_DIR=~/.cache/pip
POETRY_CACHE_DIR=~/.cache/poetry
VENV_CACHE_DIR=~/repos/coordinate-recorder-manager/.venvs

# Node.js キャッシュ設定
NPM_CONFIG_CACHE=~/.cache/npm
YARN_CACHE_FOLDER=~/.cache/yarn
PNPM_HOME=~/.cache/pnpm

# === Default Storage Configuration ===
STORAGE_TYPE=gcs
GCS_BUCKET_NAME=example-wardrobe-dev



# === Notification Configuration ===
# Discord Webhook URL for system alerts and monitoring
# Set this to your Discord webhook URL to receive notifications
# Example: DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdefgh...
DISCORD_WEBHOOK_URL=
