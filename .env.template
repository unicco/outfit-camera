# .env.template
# 環境設定テンプレート
# 使用方法: cp .env.template .env として使用

# === 本番環境特有の設定 ===
NODE_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# === 本番環境URL ===
VITE_API_URL=http://pi-camera.local:8000
VITE_CAMERA_URL=http://pi-camera.local:8001

# === CORS設定 ===
# 本番環境（Cloudflare Tunnel使用時）のドメイン設定
# ENV=production の場合に必要
# PRODUCTION_DOMAIN=yourdomain.com

# === 本番データベース ===
DATABASE_URL=postgresql+psycopg://coordinate_user:coordinate_pass@localhost:5438/coordinate_db

# === GitHub Actions Test Database ===
DATABASE_TEST_URL=postgresql://postgres_test_user:postgres_test_password@localhost:5432/postgres_test_db

# === GCS 本番設定 ===
STORAGE_TYPE=gcs
GCS_BUCKET_NAME=example-wardrobe-prod
# GCS_PROJECT_ID=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/runtime-service-account.json  # ランタイム用
# TF_GOOGLE_APPLICATION_CREDENTIALS=/Users/your-username/.config/gcloud/terraform-runner-dev.json  # Terraform 用

# === PIR センサー設定 ===
PIR_ENABLED=true
PIR_GPIO_PIN=18
PIR_SIMULATION_MODE=false
PIR_DETECTION_THRESHOLD=2
PIR_DETECTION_WINDOW=3

# === ディスプレイ制御設定 (PIR Enhanced) ===
PIR_INACTIVITY_TIMEOUT=15

# === MobileSAM モデルパス ===
# 共有ストレージ上に MobileSAM のチェックポイントを配置する場合に設定
# MOBILE_SAM_MODEL_DIR=/path/to/shared/models/mobilesam

# === カメラモード設定 ===
CAMERA_ACTIVE_DURATION=120

# === パフォーマンス最適化 ===
STREAMING_FPS=10.0

# === 画面輝度制御設定 ===
# 輝度制御は /config/brightness-control.conf で設定されます
# BRIGHT_LEVEL, DIM_LEVEL, OFF_LEVEL などの値を調整してください

# === 日付リセット設定 ===

# === Resource Management (Long-term Operation) ===
RESOURCE_CLEANUP_INTERVAL=3600
MAX_PIR_HISTORY_AGE=300

# === カメラ設定 ===
CAMERA_MODE=hardware
# 待機・ライブ映像用と撮影用。
# 🚨 **要求した大きさで選ばれるセンサーモードが変わり、モードごとに読む範囲が違う。**
# IMX708 wide の 1536x864 は中央 3072x1728 しか読まないので、1280x720 で撮ると
# ライブ映像（1920x1080 -> 2304x1296 = 全域）の 2/3 しか写らない。
# いまは両方を賄えるモードに固定するので片方だけ下げても画角は動かない。
# 🚨 **その代わり待機用だけ下げても発熱は減らない**（raw の読み出しは撮影用に合わせて
# 大きいまま）。減らすには両方下げるが、そうすると**画角も狭くなる**。
# ⚠️ 縦横比も揃える（違うと画面側の object-cover が削る量まで変わる）。
# 確認は /status の resolution.sensor_mode と aspect_matches
CAMERA_DETECTION_WIDTH=1920
CAMERA_DETECTION_HEIGHT=1080
# Capture resolution (for photos)
CAMERA_CAPTURE_WIDTH=1920
CAMERA_CAPTURE_HEIGHT=1080
# Camera orientation
CAMERA_VFLIP=false
CAMERA_HFLIP=true
# 取り付けの傾きを起こす微小回転。正の値で反時計回り。玄関の実機の実測値は 4.1。
# 🚨 **測るのは光軸上に垂らした下げ振りで。**ドア枠や戸棚の縁から測ると、カメラが
# 下を向いていることによる垂直線の収束を傾きと取り違える（実際に符号ごと間違えた）。
# ⚠️ 単体だと黒い角を出さないぶん拡大するので画角を食う（1080x1920 の 4.1 度で 12.5%）。
# 下の CAMERA_CENTER_ZOOM と併用すればタダになる。測り方は docs/setup/touchscreen-setup.md
CAMERA_ROTATION_FINE_DEG=4.1
# 中央だけを使う倍率（1.0 で切り出しなし・上限 3.0）。広角レンズの歪みが小さい中心部に
# 寄るので顔の引き伸ばしが減る。1.5 で以前の 1536x864 モード時代と同じ framing。
CAMERA_CENTER_ZOOM=1.5

# === カメラ露出設定 ===
# カメラは自動露出（AE）モードで動作します
# Picamera2 が環境光に応じて自動的に露出を調整します

# === 熱制御設定 ===
THERMAL_LIGHT_THROTTLE=75.0
THERMAL_HEAVY_THROTTLE=80.0
THERMAL_RECOVERY=60.0
THERMAL_MONITOR_INTERVAL=30.0

# === AI/ML Configuration ===
# Roboflow API Key for clothing detection (Issue #905)
# 取得先: https://app.roboflow.com/account
ROBOFLOW_KEY=your-roboflow-api-key-here

# Jina API Key for wardrobe matching embeddings
# 取得先: https://jina.ai/embeddings/
JINA_API_KEY=your-jina-api-key-here

# === External Rental API Token (optional shared secret) ===
EXTERNAL_RENTAL_API_TOKEN=
EXTERNAL_RENTAL_AUTH_BYPASS=false

# === Google Photos API 設定 ===
# Google Photos 連携機能の設定（Issue #880）
# Google Cloud Console で作成したOAuth 2.0 認証情報ファイルのパス
GOOGLE_CREDENTIALS_FILE=/path/to/google_photos_credentials.json

# Google Photos API のトークンファイル（認証完了後に自動生成される）
GOOGLE_TOKEN_FILE=/path/to/google_photos_token.json

# Google Photos アルバム名（写真を保存するアルバム名、存在しない場合は自動作成される）
GOOGLE_PHOTOS_ALBUM_NAME=Coordinate Records

# Google Photos アップロード時のリトライ設定
GOOGLE_PHOTOS_MAX_RETRIES=3
GOOGLE_PHOTOS_RETRY_DELAY=1.0

# Google Photos OAuth リダイレクトベースURL（Cloudflare Access使用時は調整が必要）
# 本番環境では https://coordinate-recorder.unicco.app を使用
GOOGLE_REDIRECT_BASE_URL=http://localhost:8080

# === Discord 通知設定 ===
# Google Photos 認証失効などのアラート通知先設定
# 例: https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
DISCORD_ALERT_WEBHOOK_URL=
# Webhook 上で表示する任意のユーザー名（未設定の場合はデフォルト名を使用）
DISCORD_ALERT_USERNAME=Coordinate Recorder Monitor
# 任意: 通知時にメンションするユーザーまたはロール（例: "<@1234567890>" のように必ず二重引用符で囲む）
DISCORD_ALERT_MENTION=
# 任意: Webhook メッセージに使用するアバター画像 URL
DISCORD_ALERT_AVATAR_URL=
# 任意: Google Photos アラートメッセージをカスタマイズする場合に利用
GOOGLE_PHOTOS_DISCORD_MESSAGE=

# === Google Calendar API 設定 ===
# Google Calendar 連携で代理アクセスを行うユーザー（service account から委任する場合）
# 例: GOOGLE_CALENDAR_DELEGATED_USER=admin@example.com
GOOGLE_CALENDAR_DELEGATED_USER=

# 主要なカレンダー ID（通常は primary）
# 例: GOOGLE_CALENDAR_PRIMARY_ID=primary
GOOGLE_CALENDAR_PRIMARY_ID=

# 追加で購読するカレンダー ID をカンマ区切りで指定
# 例: GOOGLE_CALENDAR_EXTRA_IDS=team_calendar_id,personal_events_id
GOOGLE_CALENDAR_EXTRA_IDS=


# === External rental API 認証設定 ===
# 本番環境では Cloudflare Access 経由か、Bearer トークンでの認証が必須です。
# 自動化スクリプト等で利用する場合は API トークンを設定し、Authorization: Bearer ヘッダーに付与してください。
EXTERNAL_RENTAL_API_TOKEN=
# 開発で強制的に認証を有効にする場合は true（auto は本番のみ有効化）
EXTERNAL_RENTAL_AUTH_REQUIRED=auto
# トラブルシューティング向けの一時的な無効化フラグ（本番では空のままにする）
EXTERNAL_RENTAL_AUTH_DISABLED=

# === Cloudflare Access 閲覧専用モード ===
# カンマ区切りで指定したメールアドレスを閲覧専用モードにする（例: foo@example.com,bar@example.com）
# Cloudflare Access が付与する Cf-Access-Authenticated-User-Email を照合して判定
READ_ONLY_CLOUDFLARE_EMAILS=
# ※ DEMO_READONLY_EMAILS は参照されません。READ_ONLY_CLOUDFLARE_EMAILS を使用してください

# === VLM 検出設定 ===
# Gemini API Key（VLM 検出で優先使用、無料枠あり）
# 取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === 環境別パス設定 ===
# 開発環境（macOS）の例
# VENV_CACHE_DIR=/Users/your-username/repos/coordinate-recorder/.venvs
# PIP_CACHE_DIR=/Users/your-username/.cache/pip
# POETRY_CACHE_DIR=/Users/your-username/repos/coordinate-recorder/.cache/poetry

# 本番環境（Raspberry Pi）の例
# VENV_CACHE_DIR=/home/pi/.coordinate-recorder-cache/venv
# PIP_CACHE_DIR=/home/pi/.cache/pip
# POETRY_CACHE_DIR=/home/pi/.cache/poetry

# VPS 環境の例
# DATABASE_URL=postgresql+psycopg://coordinate_user:coordinate_pass@localhost:5432/coordinate_db
# STORAGE_TYPE=local
# PHOTOS_DIR=/home/deploy/services/coordinate-recorder/photos
# VITE_API_URL=https://coordinate.unicco.app

SKIP_DEPENDENCY_INSTALL=
