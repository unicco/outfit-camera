build/
*.egg-info/

# Legacy infrastructure files (no longer used)
# docker-compose.override.yml

# Git worktrees (temporary development branches)
worktrees/

# Temporary directories
temp/

# Photos directory (captured images should not be committed)
photos/

# Exhibition directory (large assets, keep local only)
# ⚠️ 先頭の / は外さない。無いと scripts/exhibition/ のコードまで巻き込み、
# 新しいスクリプトが黙って commit されない（既存分は追跡済なので気づけない）
/exhibition/
*.jpg
*.jpeg
*.png
*.bmp

# Log files
logs/
*.log
api/logs/

# Generated nginx config files (use templates instead)
config/nginx/*.conf
!config/nginx/includes/*.conf
!config/nginx/*.template.conf

# Local data directories
data/

# GCS secrets and credentials
secrets/
gcs-service-account-key.json
*-service-account-key.json
*.json.bak

# Deployment artifacts
*.tar.gz

# Deployment runtime files (環境固有の実行時ファイル)
